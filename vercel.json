{
  "buildCommand": "pnpm migrate up && expo export --platform web",
  "outputDirectory": "dist/client",
  "functions": {
    "api/index.mts": {
      "runtime": "@vercel/node@5.1.8",
      "includeFiles": "dist/server/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.mts"
    }
  ]
}
